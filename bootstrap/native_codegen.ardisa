module native_codegen

fn escape(value: String) -> String
  let result = ""
  let index = 0
  while index < len(value)
    let c = value[index]
    if c == 92
      set result = result + "\\"
    else
      if c == 124
        set result = result + "\p"
      else
        if c == 44
          set result = result + "\c"
        else
          if c == 10
            set result = result + "\n"
          else
            set result = result + chr(c)
    set index = index + 1
  result

fn push_int(value: Int) -> String
  "I|PushInt:" + value + "\n"

fn push_bool(value: Bool) -> String
  if value
    "I|PushBool:true\n"
  else
    "I|PushBool:false\n"

fn push_unit() -> String
  "I|PushUnit\n"

fn push_string(value: String) -> String
  "I|PushString:" + escape(value) + "\n"

fn load(name: String) -> String
  "I|Load:" + escape(name) + "\n"

fn store(name: String) -> String
  "I|Store:" + escape(name) + "\n"

fn binary(kind: String) -> String
  "I|" + kind + "\n"

fn ret() -> String
  "I|Return\n"

fn artifact(function_name: String, parameter_count: Int, parameters: String, code: String) -> String
  "ARDISA-EXEC-V1\nFN|" + escape(function_name) + "|" + chr(48 + parameter_count) + "|" + parameters + "\n" + code + "END\n

fn validate(artifact_text: String) -> String
  if len(artifact_text) >= 14
    if artifact_text[0] == 65
      if artifact_text[1] == 82
        if artifact_text[2] == 68
          if artifact_text[3] == 73
            if artifact_text[4] == 83
              if artifact_text[5] == 65
                "Ok"
              else
                "Err:bad-magic"
            else
              "Err:bad-magic"
          else
            "Err:bad-magic"
        else
          "Err:bad-magic"
      else
        "Err:bad-magic"
    else
      "Err:bad-magic"
  else
    "Err:short-artifact"
