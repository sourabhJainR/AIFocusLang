module native_codegen

fn escape(value: String) -> String
  let result = ""
  let index = 0
  while index < len(value)
    let c = value[index]
    if c == 92
      set result = result + "\\"
    else
      if c == 124
        set result = result + "\p"
      else
        if c == 44
          set result = result + "\c"
        else
          if c == 10
            set result = result + "\n"
          else
            set result = result + chr(c)
    set index = index + 1
  result

fn push_string(value: String) -> String
  "I|PushString:" + escape(value) + "\n"

fn load(name: String) -> String
  "I|Load:" + escape(name) + "\n"

fn store(name: String) -> String
  "I|Store:" + escape(name) + "\n"

fn binary(kind: String) -> String
  "I|" + kind + "\n"

fn artifact(function_name: String, parameters: String, code: String) -> String
  "ARDISA-EXEC-V1\nFN|" + escape(function_name) + "|" + parameters + "|" + parameters + "\n" + code + "END\n"

fn validate(artifact_text: String) -> String
  if len(artifact_text) >= 14
    if artifact_text[0] == 65
      "Ok"
    else
      "Err:bad-magic"
  else
    "Err:short-artifact"
