module compiler

fn is_letter(c: Int) -> Bool
  if c == 95
    true
  else
    if c >= 65
      if c <= 90
        true
      else
        if c >= 97
          if c <= 122
            true
          else
            false
        else
          false
    else
      false

fn is_digit(c: Int) -> Bool
  if c >= 48
    if c <= 57
      true
    else
      false
  else
    false

fn token(kind: String, value: String) -> String
  kind + "=" + value + "|"

fn keyword(word: String) -> String
  if word == "module"
    "Module"
  else
    if word == "fn"
      "Fn"
    else
      if word == "if"
        "If"
      else
        if word == "else"
          "Else"
        else
          if word == "let"
            "Let"
          else
            if word == "set"
              "Set"
            else
              if word == "return"
                "Return"
              else
                if word == "scope"
                  "Scope"
                else
                  if word == "spawn"
                    "Spawn"
                  else
                    if word == "join"
                      "Join"
                    else
                      if word == "cancel"
                        "Cancel"
                      else
                        if word == "while"
                          "While"
                        else
                          if word == "true"
                            "True"
                          else
                            if word == "false"
                              "False"
                            else
                              "Ident"

fn lex_source(source: String) -> String
  let output = ""
  let index = 0
  let indent = 0
  let line_start = true
  while index < len(source)
    if line_start
      let spaces = 0
      let scanning_spaces = true
      let pending_index = index
      while index < len(source)
        if scanning_spaces == true
          if source[index] == 32
            set spaces = spaces + 1
            set index = index + 1
          else
            set pending_index = index
            set scanning_spaces = false
            set index = len(source)
      set index = pending_index
      if spaces > indent
        set indent = spaces
        set output = output + token("Indent", chr(spaces))
      else
        if spaces < indent
          while indent > spaces
            if indent > 1
              set indent = indent - 2
            else
              set indent = 0
            set output = output + token("Dedent", "")
      set line_start = false
    if index < len(source)
      let c = source[index]
      if c == 10
        set output = output + token("Newline", "")
        set index = index + 1
        set line_start = true
      else
        if c == 32
          set index = index + 1
        else
          if c == 35
            while index < len(source)
              if source[index] == 10
                set line_start = true
                set index = index + 1
              else
                set index = index + 1
          else
            if is_letter(c)
              let word = ""
              let scanning_word = true
              let pending_index = index
              while index < len(source)
                if scanning_word == true
                  if is_letter(source[index])
                    set word = word + chr(source[index])
                    set index = index + 1
                  else
                    if is_digit(source[index])
                      set word = word + chr(source[index])
                      set index = index + 1
                    else
                      set pending_index = index
                      set scanning_word = false
                      set index = len(source)
              set index = pending_index
              set output = output + token(keyword(word), word)
            else
              if is_digit(c)
                let number = ""
                let scanning_number = true
                let pending_index = index
                while index < len(source)
                  if scanning_number == true
                    if is_digit(source[index])
                      set number = number + chr(source[index])
                      set index = index + 1
                    else
                      set pending_index = index
                      set scanning_number = false
                      set index = len(source)
                set index = pending_index
                set output = output + token("Int", number)
              else
                if c == 34
                  let value = ""
                  set index = index + 1
                  let closed = false
                  let pending_index = index
                  while index < len(source)
                    if closed == false
                      if source[index] == 34
                        set closed = true
                        set pending_index = index + 1
                        set index = len(source)
                      else
                        set value = value + chr(source[index])
                        set index = index + 1
                  set index = pending_index
                  set output = output + token("String", value)
                else
                  if c == 45
                    if index + 1 < len(source)
                      if source[index + 1] == 62
                        set output = output + token("Arrow", "->")
                        set index = index + 2
                      else
                        set output = output + token("Minus", "-")
                        set index = index + 1
                    else
                      set output = output + token("Minus", "-")
                      set index = index + 1
                  else
                    if c == 61
                      if index + 1 < len(source)
                        if source[index + 1] == 61
                          set output = output + token("EqualEqual", "==")
                          set index = index + 2
                        else
                          set output = output + token("Equal", "=")
                          set index = index + 1
                      else
                        set output = output + token("Equal", "=")
                        set index = index + 1
                    else
                      if c == 33
                        if index + 1 < len(source)
                          if source[index + 1] == 61
                            set output = output + token("NotEqual", "!=")
                            set index = index + 2
                          else
                            set output = output + token("NotEqual", "!")
                            set index = index + 1
                        else
                          set output = output + token("NotEqual", "!")
                          set index = index + 1
                      else
                        if c == 60
                          if index + 1 < len(source)
                            if source[index + 1] == 61
                              set output = output + token("LessEqual", "<=")
                              set index = index + 2
                            else
                              set output = output + token("Less", "<")
                              set index = index + 1
                          else
                            set output = output + token("Less", "<")
                            set index = index + 1
                        else
                          if c == 62
                            if index + 1 < len(source)
                              if source[index + 1] == 61
                                set output = output + token("GreaterEqual", ">=")
                                set index = index + 2
                              else
                                set output = output + token("Greater", ">")
                                set index = index + 1
                            else
                              set output = output + token("Greater", ">")
                              set index = index + 1
                          else
                            if c == 43
                              set output = output + token("Plus", "+")
                              set index = index + 1
                            else
                              if c == 42
                                set output = output + token("Star", "*")
                                set index = index + 1
                              else
                                if c == 47
                                  set output = output + token("Slash", "/")
                                  set index = index + 1
                                else
                                  if c == 37
                                    set output = output + token("Percent", "%")
                                    set index = index + 1
                                  else
                                    if c == 44
                                      set output = output + token("Comma", ",")
                                      set index = index + 1
                                    else
                                      if c == 58
                                        set output = output + token("Colon", ":")
                                        set index = index + 1
                                      else
                                        if c == 91
                                          set output = output + token("LBracket", "[")
                                          set index = index + 1
                                        else
                                          if c == 93
                                            set output = output + token("RBracket", "]")
                                            set index = index + 1
                                          else
                                            if c == 40
                                              set output = output + token("LParen", "(")
                                              set index = index + 1
                                            else
                                              if c == 41
                                                set output = output + token("RParen", ")")
                                                set index = index + 1
                                              else
                                                set output = output + token("Unknown", chr(c))
                                                set index = index + 1
  while indent > 0
    if indent > 1
      set indent = indent - 2
    else
      set indent = 0
    set output = output + token("Dedent", "")
  set output = output + token("Eof", "")
  output

fn token_kind(token: String) -> String
  let index = 0
  let result = ""
  while index < len(token)
    if token[index] == 61
      set index = len(token)
    else
      set result = result + chr(token[index])
      set index = index + 1
  result

fn token_value(token: String) -> String
  let index = 0
  let result = ""
  let seen = false
  while index < len(token)
    if seen == false
      if token[index] == 61
        set seen = true
    else
      if token[index] == 124
        set index = len(token)
      else
        set result = result + chr(token[index])
    set index = index + 1
  result

fn token_at(stream: String, start: Int) -> String
  let end = start
  let delimiter = start
  let scanning = true
  while end < len(stream)
    if scanning == true
      if stream[end] == 124
        set delimiter = end
        set scanning = false
        set end = len(stream)
      else
        set end = end + 1
  let result = ""
  let index = start
  while index < delimiter
    set result = result + chr(stream[index])
    set index = index + 1
  result

fn next_cursor(stream: String, start: Int) -> Int
  let index = start
  let delimiter = start
  let scanning = true
  while index < len(stream)
    if scanning == true
      if stream[index] == 124
        set delimiter = index
        set scanning = false
        set index = len(stream)
      else
        set index = index + 1
  delimiter

fn node(kind: String, value: String) -> String
  if kind == "String"
    "(String)"
  else
    if len(value) > 0
      "(" + kind + " " + value + ")"
    else
      "(" + kind + ")"

fn parse_tokens(stream: String) -> String
  let result = "(Module"
  let cursor = 0
  let seen_module = false
  let in_function = false
  let in_body = false
  let body_depth = 0
  while cursor < len(stream)
    let token = token_at(stream, cursor)
    let kind = token_kind(token)
    let value = token_value(token)
    if kind == "Module"
      set seen_module = true
      set result = result + " " + node("ModuleDecl", value)
    else
      if kind == "Fn"
        if in_function == true
          if in_body == true
            set result = result + ")"
            set in_body = false
            set body_depth = 0
          set result = result + ")"
        set result = result + " (Function"
        set in_function = true
      else
        if kind == "Indent"
          if in_function == true
            if in_body == false
              set result = result + " (Body"
              set in_body = true
            set body_depth = body_depth + 1
        else
          if kind == "Dedent"
            if in_body == true
              if body_depth > 1
                set body_depth = body_depth - 1
              else
                set result = result + ")"
                set in_body = false
                set body_depth = 0
                if in_function == true
                  set result = result + ")"
                  set in_function = false
          else
            if kind == "Newline"
              set result = result
            else
              if in_function == true
                set result = result + " " + node(kind, value)
              else
                if seen_module == false
                  set result = result
    set cursor = next_cursor(stream, cursor) + 1
  if in_body == true
    set result = result + ")"
  if in_function == true
    set result = result + ")"
  result + ")"

fn build_ast(parsed: String) -> String
  if len(parsed) == 0
    ""
  else
    if parsed[0] == 40
      "(ModuleAST " + parsed + ")"
    else
      ""

fn contains(text: String, needle: String) -> Bool
  let index = 0
  let found = false
  while index < len(text)
    if found == false
      let offset = 0
      let same = true
      while offset < len(needle)
        if index + offset >= len(text)
          set same = false
        else
          if text[index + offset] != needle[offset]
            set same = false
        set offset = offset + 1
      if same == true
        set found = true
    set index = index + 1
  found

fn balanced(ast: String) -> Bool
  let depth = 0
  let index = 0
  let valid = true
  let in_string = false
  while index < len(ast)
    if ast[index] == 34
      if in_string == true
        set in_string = false
      else
        set in_string = true
    else
      if in_string == false
        if ast[index] == 40
          set depth = depth + 1
        else
          if ast[index] == 41
            if depth > 0
              set depth = depth - 1
            else
              set valid = false
    set index = index + 1
  if depth == 0
    valid
  else
    false

fn check_ast(ast: String) -> String
  if len(ast) == 0
    "Err:empty-ast"
  else
    if contains(ast, "(Module")
      if contains(ast, "(ModuleDecl")
        if contains(ast, "(Function")
          if contains(ast, "(Body")
            if contains(ast, "(Unknown")
              "Err:unknown-token"
            else
              if balanced(ast)
                "Ok"
              else
                "Err:unbalanced-ast"
          else
            "Err:missing-function-body"
        else
          "Err:missing-function"
      else
        "Err:missing-module-name"
    else
      "Err:missing-module"

fn classify(atom: String) -> String
  if atom == "Module"
    "MODULE"
  else
    if atom == "ModuleDecl"
      "MODULE_DECL"
    else
      if atom == "Function"
        "FUNCTION"
      else
        if atom == "Body"
          "BLOCK"
        else
          if atom == "Let"
            "LET"
          else
            if atom == "Set"
              "SET"
            else
              if atom == "Return"
                "RETURN"
              else
                if atom == "If"
                  "IF"
                else
                  if atom == "While"
                    "WHILE"
                  else
                    if atom == "Call"
                      "CALL"
                    else
                      "ATOM"

fn op(kind: String, value: String) -> String
  kind + "(" + value + ")"

fn optimize_ir(ir: String) -> String
  let result = ""
  let index = 0
  while index < len(ir)
    if ir[index] == 32
      set index = index + 1
    else
      set result = result + chr(ir[index])
      set index = index + 1
  result

fn lower_ir(ast: String) -> String
  let result = "IR["
  let index = 0
  while index < len(ast)
    if ast[index] == 40
      set result = result + "BEGIN,"
      set index = index + 1
    else
      if ast[index] == 41
        set result = result + "END,"
        set index = index + 1
      else
        if ast[index] == 32
          set index = index + 1
        else
          let atom = ""
          let pending_index = index
          let scanning = true
          while index < len(ast)
            if scanning == true
              if ast[index] == 32
                set pending_index = index
                set scanning = false
                set index = len(ast)
              else
                if ast[index] == 40
                  set pending_index = index
                  set scanning = false
                  set index = len(ast)
                else
                  if ast[index] == 41
                    set pending_index = index
                    set scanning = false
                    set index = len(ast)
                  else
                    set atom = atom + chr(ast[index])
                    set index = index + 1
          if scanning == true
            set pending_index = index
          set index = pending_index
          set result = result + op(classify(atom), atom) + ","
  result + "]"


fn find_delimiter(stream: String, start: Int) -> Int
  let index = start
  while index < len(stream)
    if stream[index] == 124
      return index
    set index = index + 1
  len(stream)

fn field(stream: String, start: Int, which: Int) -> String
  let index = start
  let part = 0
  let result = ""
  let active = false
  while index < len(stream)
    let c = stream[index]
    if c == 124
      if part == which
        return result
      set part = part + 1
      set result = ""
    else
      if part == which
        set result = result + chr(c)
    set index = index + 1
  result

fn token_end(stream: String, start: Int) -> Int
  find_delimiter(stream, start)

fn op_precedence(kind: String) -> Int
  if kind == "EqualEqual"
    1
  else
    if kind == "NotEqual"
      1
    else
      if kind == "Less"
        1
      else
        if kind == "LessEqual"
          1
        else
          if kind == "Greater"
            1
          else
            if kind == "GreaterEqual"
              1
            else
              if kind == "Plus"
                2
              else
                if kind == "Minus"
                  2
                else
                  if kind == "Star"
                    3
                  else
                    if kind == "Slash"
                      3
                    else
                      if kind == "Percent"
                        3
                      else
                        0

fn emit_op(kind: String) -> String
  if kind == "Plus"
    "Add"
  else
    if kind == "Minus"
      "Sub"
    else
      if kind == "Star"
        "Mul"
      else
        if kind == "Slash"
          "Div"
        else
          if kind == "Percent"
            "Mod"
          else
            if kind == "EqualEqual"
              "Equal"
            else
              if kind == "NotEqual"
                "NotEqual"
              else
                if kind == "Less"
                  "Less"
                else
                  if kind == "LessEqual"
                    "LessEqual"
                  else
                    if kind == "Greater"
                      "Greater"
                    else
                      "GreaterEqual"

fn parse_primary(stream: String, start: Int) -> String
  let token = token_at(stream, start)
  let kind = token_kind(token)
  let value = token_value(token)
  let next = next_cursor(stream, start) + 1
  if kind == "Int"
    next + "#" + "PushInt:" + value + chr(10)
  else
    if kind == "True"
      next + "#PushBool:true" + chr(10)
    else
      if kind == "False"
        next + "#PushBool:false" + chr(10)
      else
        if kind == "String"
          next + "#PushString:" + value + chr(10)
        else
          if kind == "Ident"
            let after = token_at(stream, next)
            let after_kind = token_kind(after)
            if after_kind == "LParen"
              let cursor = next_cursor(stream, next) + 1
              let code = ""
              let argc = 0
              let done = false
              while done == false
                let arg = token_at(stream, cursor)
                let arg_kind = token_kind(arg)
                if arg_kind == "RParen"
                  set done = true
                else
                  let parsed = parse_expr(stream, cursor, 0)
                  let split = find_hash(parsed)
                  let arg_cursor = parse_int(prefix(parsed, split))
                  set code = code + suffix(parsed, split) 
                  set argc = argc + 1
                  set cursor = arg_cursor
                  let comma = token_at(stream, cursor)
                  if token_kind(comma) == "Comma"
                    set cursor = next_cursor(stream, cursor) + 1
                  else
                    if token_kind(comma) == "RParen"
                      set done = true
              let close = next_cursor(stream, cursor) + 1
              close + "#" + code + "Call:" + value + "," + argc + chr(10)
            else
              if after_kind == "LBracket"
                let cursor = next_cursor(stream, next) + 1
                let parsed = parse_expr(stream, cursor, 0)
                let split = find_hash(parsed)
                let after_expr = parse_int(prefix(parsed, split))
                let code = suffix(parsed, split)
                let close = next_cursor(stream, after_expr)
                close + 1 + "#" + "Load:" + value + chr(10) + code + "Index" + chr(10)
              else
                next + "#Load:" + value + chr(10)
          else
            if kind == "LParen"
              let parsed = parse_expr(stream, next, 0)
              let split = find_hash(parsed)
              let after_expr = parse_int(prefix(parsed, split))
              let close = next_cursor(stream, after_expr)
              close + 1 + "#" + suffix(parsed, split)
            else
              if kind == "LBracket"
                let cursor = next
                let code = ""
                let count = 0
                let done = false
                while done == false
                  let item = token_at(stream, cursor)
                  if token_kind(item) == "RBracket"
                    set done = true
                  else
                    let parsed = parse_expr(stream, cursor, 0)
                    let split = find_hash(parsed)
                    set cursor = parse_int(prefix(parsed, split))
                    set code = code + suffix(parsed, split)
                    set count = count + 1
                    let separator = token_at(stream, cursor)
                    if token_kind(separator) == "Comma"
                      set cursor = next_cursor(stream, cursor) + 1
                    else
                      if token_kind(separator) == "RBracket"
                        set done = true
                next_cursor(stream, cursor) + 1 + "#" + code + "PushList:" + count + chr(10)
              else
                next + "#PushUnit" + chr(10)

fn find_hash(value: String) -> Int
  let index = 0
  while index < len(value)
    if value[index] == 35
      return index
    set index = index + 1
  len(value)

fn prefix(value: String, end: Int) -> String
  let result = ""
  let index = 0
  while index < end
    set result = result + chr(value[index])
    set index = index + 1
  result

fn suffix(value: String, start: Int) -> String
  let result = ""
  let index = start + 1
  while index < len(value)
    set result = result + chr(value[index])
    set index = index + 1
  result

fn parse_int(value: String) -> Int
  let result = 0
  let index = 0
  while index < len(value)
    set result = result * 10 + (value[index] - 48)
    set index = index + 1
  result

fn parse_expr(stream: String, start: Int, minimum: Int) -> String
  let parsed = parse_primary(stream, start)
  let split = find_hash(parsed)
  let cursor = parse_int(prefix(parsed, split))
  let code = suffix(parsed, split)
  let next = cursor
  let kind = token_kind(token_at(stream, next))
  let precedence = op_precedence(kind)
  if precedence > minimum
    let right = parse_expr(stream, next_cursor(stream, next) + 1, precedence)
    let right_split = find_hash(right)
    let right_cursor = parse_int(prefix(right, right_split))
    set code = code + suffix(right, right_split) + emit_op(kind) + chr(10)
    set cursor = right_cursor
  cursor + "#" + code

fn line_end(stream: String, start: Int) -> Int
  let cursor = start
  while cursor < len(stream)
    if token_kind(token_at(stream, cursor)) == "Newline"
      return cursor
    set cursor = next_cursor(stream, cursor) + 1
  cursor

fn parse_type(stream: String, start: Int) -> String
  let token = token_at(stream, start)
  let kind = token_kind(token)
  if kind == "Ident"
    token_value(token)
  else
    "()"

fn parse_params(stream: String, start: Int) -> String
  let cursor = start
  let result = ""
  let done = false
  while done == false
    let token = token_at(stream, cursor)
    let kind = token_kind(token)
    if kind == "RParen"
      set done = true
    else
      if kind == "Ident"
        set result = result + token_value(token) + ","
        set cursor = next_cursor(stream, cursor) + 1
        if token_kind(token_at(stream, cursor)) == "Colon"
          set cursor = next_cursor(stream, cursor) + 1
        set cursor = next_cursor(stream, cursor) + 1
        if token_kind(token_at(stream, cursor)) == "Comma"
          set cursor = next_cursor(stream, cursor) + 1
      else
        set cursor = next_cursor(stream, cursor) + 1
  result

fn compile_statement(stream: String, start: Int, label: Int) -> String
  let token = token_at(stream, start)
  let kind = token_kind(token)
  let next = next_cursor(stream, start) + 1
  let end = line_end(stream, start)
  if kind == "Let"
    let name = token_value(token_at(stream, next))
    let value_start = next_cursor(stream, next_cursor(stream, next) + 1) + 1
    let parsed = parse_expr(stream, value_start, 0)
    let split = find_hash(parsed)
    suffix(parsed, split) + "Store:" + name + chr(10)
  else
    if kind == "Set"
      let name = token_value(token_at(stream, next))
      let value_start = next_cursor(stream, next_cursor(stream, next) + 1) + 1
      let parsed = parse_expr(stream, value_start, 0)
      let split = find_hash(parsed)
      suffix(parsed, split) + "Store:" + name + chr(10)
    else
      if kind == "Return"
        if token_kind(token_at(stream, next)) == "Newline"
          "PushUnit" + chr(10) + "Return" + chr(10)
        else
          let parsed = parse_expr(stream, next, 0)
          let split = find_hash(parsed)
          suffix(parsed, split) + "Return" + chr(10)
      else
        if kind == "If"
          let parsed = parse_expr(stream, next, 0)
          let split = find_hash(parsed)
          suffix(parsed, split) + "JumpIfFalse:$L" + label + chr(10)
        else
          if kind == "While"
            let parsed = parse_expr(stream, next, 0)
            let split = find_hash(parsed)
            "LABEL:$W" + label + chr(10) + suffix(parsed, split) + "JumpIfFalse:$E" + label + chr(10)
          else
            if kind == "Expr"
              let parsed = parse_expr(stream, start, 0)
              let split = find_hash(parsed)
              suffix(parsed, split) + "Pop" + chr(10)
            else
              let parsed = parse_expr(stream, start, 0)
              let split = find_hash(parsed)
              suffix(parsed, split) + "Pop" + chr(10)

fn push_context(stack: String, kind: String, label: Int) -> String
  stack + kind + ":" + label + "|"

fn last_context(stack: String) -> String
  let index = len(stack) - 1
  while index >= 0
    if stack[index] == 124
      let start = index - 1
      while start >= 0
        if stack[start] == 124
          return slice(stack, start + 1, index)
        set start = start - 1
      return slice(stack, 0, index)
    set index = index - 1
  ""

fn pop_context(stack: String) -> String
  let index = len(stack) - 1
  while index >= 0
    if stack[index] == 124
      let start = index - 1
      while start >= 0
        if stack[start] == 124
          return slice(stack, 0, start + 1)
        set start = start - 1
      return ""
    set index = index - 1
  stack

fn context_kind(context: String) -> String
  if len(context) > 0
    chr(context[0])
  else
    ""

fn context_label(context: String) -> Int
  let index = 2
  let result = 0
  while index < len(context)
    set result = result * 10 + (context[index] - 48)
    set index = index + 1
  result

fn compile_native(source: String) -> String
  let tokens = lex_source(source)
  let cursor = 0
  let program = ""
  let function_name = ""
  let params = ""
  let code = ""
  let labels = 0
  let in_function = false
  let block_stack = ""
  let block_depth = 0
  while cursor < len(tokens)
    let token = token_at(tokens, cursor)
    let kind = token_kind(token)
    if kind == "Fn"
      if in_function == true
        set code = code + "Return" + chr(10)
        set program = program + "FN|" + function_name + "|" + count_params(params) + "|" + params + chr(10) + code + "END" + chr(10)
      let name_cursor = next_cursor(tokens, cursor) + 1
      let name_token = token_at(tokens, name_cursor)
      set function_name = token_value(name_token)
      let paren_cursor = next_cursor(tokens, name_cursor) + 1
      set params = parse_params(tokens, paren_cursor)
      set cursor = line_end(tokens, cursor)
      set block_stack = ""
      set block_depth = 0
      set in_function = true
    else
      if in_function == true
        if kind == "Indent"
          set block_depth = block_depth + 1
        else
          if kind == "Dedent"
            if block_depth > 0
              let context = last_context(block_stack)
              set block_stack = pop_context(block_stack)
              set block_depth = block_depth - 1
              if context_kind(context) == "I"
                set code = code + "LABEL:$E" + context_label(context) + chr(10)
              else
                if context_kind(context) == "E"
                  set code = code + "LABEL:$E" + context_label(context) + chr(10)
                else
                  if context_kind(context) == "W"
                    set code = code + "Jump:$W" + context_label(context) + chr(10)
                    set code = code + "LABEL:$E" + context_label(context) + chr(10)
          else
            if kind == "Else"
              let context = last_context(block_stack)
              if context_kind(context) == "I"
                let label = context_label(context)
                set code = code + "Jump:$E" + label + chr(10)
                set code = code + "LABEL:$L" + label + chr(10)
                set block_stack = pop_context(block_stack)
                set block_stack = push_context(block_stack, "E", label)
              else
                set code = code + "PushUnit" + chr(10)
            else
              if kind != "Newline" and kind != "Module" and kind != "Eof"
                if kind == "If"
                  set code = code + compile_statement(tokens, cursor, labels)
                  set block_stack = push_context(block_stack, "I", labels)
                  set labels = labels + 1
                else
                  if kind == "While"
                    set code = code + compile_statement(tokens, cursor, labels)
                    set block_stack = push_context(block_stack, "W", labels)
                    set labels = labels + 1
                  else
                    set code = code + compile_statement(tokens, cursor, labels)
    set cursor = next_cursor(tokens, cursor) + 1
  if in_function == true
    set code = code + "Return" + chr(10)
    set program = program + "FN|" + function_name + "|" + count_params(params) + "|" + params + chr(10) + code + "END" + chr(10)
  backend(program)

fn count_params(params: String) -> Int
  let count = 0
  let index = 0
  while index < len(params)
    if params[index] == 44
      set count = count + 1
    set index = index + 1
  if len(params) > 0
    count + 1
  else
    0

fn count_params(params: String) -> Int
  let count = 0
  let index = 0
  while index < len(params)
    if params[index] == 44
      set count = count + 1
    set index = index + 1
  count

fn backend(symbolic: String) -> String
  let result = "ARDISA-EXEC-V1" + chr(10)
  let cursor = 0
  let current = ""
  let code = ""
  let params = ""
  let name = ""
  while cursor < len(symbolic)
    let line = line_at(symbolic, cursor)
    if line[0] == 70
      if len(name) > 0
        set result = result + encode_function(name, params, code)
      let first = find_char(line, 124, 0)
      let second = find_char(line, 124, first + 1)
      let third = find_char(line, 124, second + 1)
      set name = slice(line, first + 1, second)
      set params = slice(line, third + 1, len(line))
      set code = ""
    else
      if line == "END"
        set result = result + encode_function(name, params, code)
        set name = ""
        set params = ""
        set code = ""
      else
        set code = code + line + chr(10)
    set cursor = next_line(symbolic, cursor)
  result

fn line_at(stream: String, start: Int) -> String
  let end = start
  while end < len(stream)
    if stream[end] == 10
      return slice(stream, start, end)
    set end = end + 1
  slice(stream, start, end)

fn next_line(stream: String, start: Int) -> Int
  let end = start
  while end < len(stream)
    if stream[end] == 10
      return end + 1
    set end = end + 1
  end

fn find_char(text: String, needle: Int, start: Int) -> Int
  let index = start
  while index < len(text)
    if text[index] == needle
      return index
    set index = index + 1
  len(text)

fn slice(text: String, start: Int, end: Int) -> String
  let result = ""
  let index = start
  while index < end
    set result = result + chr(text[index])
    set index = index + 1
  result

fn encode_instr(line: String) -> String
  "I|" + line + chr(10)

fn resolve_target(code: String, target: String) -> Int
  let pc = 0
  let cursor = 0
  while cursor < len(code)
    let line = line_at(code, cursor)
    if line == "LABEL:" + target
      return pc
    if len(line) > 0
      if line[0] != 64
        if line[0] != 76
          set pc = pc + 1
    set cursor = next_line(code, cursor)
  0

fn encode_function(name: String, params: String, code: String) -> String
  let result = "FN|" + name + "|" + count_params(params) + "|" + params + chr(10)
  let cursor = 0
  while cursor < len(code)
    let line = line_at(code, cursor)
    if len(line) > 0
      if line[0] != 76
        if line[0] == 74
          if line[1] == 117
            if line[2] == 109
              if line[3] == 112
                if line[4] == 73
                  let target = suffix(line, 15)
                  set line = "JumpIfFalse:" + resolve_target(code, target)
                else
                  let target = suffix(line, 5)
                  set line = "Jump:" + resolve_target(code, target)
        set result = result + "I|" + line + chr(10)
    set cursor = next_line(code, cursor)
  result + "END" + chr(10)

fn compile(source: String) -> String
  compile_native(source)

fn main(source: String) -> String
  compile_native(source)
