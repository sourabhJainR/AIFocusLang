module semantic

fn contains(text: String, needle: String) -> Bool
  let index = 0
  let found = false
  while index < len(text)
    if found == false
      let offset = 0
      let same = true
      while offset < len(needle)
        if index + offset >= len(text)
          set same = false
        else
          if text[index + offset] != needle[offset]
            set same = false
        set offset = offset + 1
      if same == true
        set found = true
    set index = index + 1
  found

fn balanced(ast: String) -> Bool
  let depth = 0
  let index = 0
  let valid = true
  while index < len(ast)
    if ast[index] == 40
      set depth = depth + 1
    else
      if ast[index] == 41
        if depth > 0
          set depth = depth - 1
        else
          set valid = false
    set index = index + 1
  if depth == 0
    valid
  else
    false

fn check(ast: String) -> String
  if len(ast) == 0
    "Err:empty-ast"
  else
    if contains(ast, "(Module")
      if contains(ast, "(ModuleDecl")
        if contains(ast, "(Function")
          if contains(ast, "(Body")
            if contains(ast, "(Unknown")
              "Err:unknown-token"
            else
              if balanced(ast)
                "Ok"
              else
                "Err:unbalanced-ast"
          else
            "Err:missing-function-body"
        else
          "Err:missing-function"
      else
        "Err:missing-module-name"
    else
      "Err:missing-module"
