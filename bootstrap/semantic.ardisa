module semantic

fn has_prefix(text: String, prefix: String) -> Bool
  let index = 0
  let same = true
  while index < len(prefix)
    if index >= len(text)
      set same = false
    else
      if text[index] != prefix[index]
        set same = false
    set index = index + 1
  same

fn balanced(ast: String) -> Bool
  let depth = 0
  let index = 0
  let valid = true
  while index < len(ast)
    if ast[index] == 40
      set depth = depth + 1
    else
      if ast[index] == 41
        if depth > 0
          set depth = depth - 1
        else
          set valid = false
    set index = index + 1
  if depth == 0
    valid
  else
    false

fn check(ast: String) -> String
  if len(ast) == 0
    "Err:empty-ast"
  else
    if has_prefix(ast, "(Module")
      if balanced(ast)
        "Ok"
      else
        "Err:unbalanced-ast"
    else
      "Err:missing-module"
