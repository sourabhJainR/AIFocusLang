module parser

fn token_at(stream: String, start: Int) -> String
  let end = start
  let delimiter = start
  let scanning = true
  while end < len(stream)
    if scanning == true
      if stream[end] == 124
        set delimiter = end
        set scanning = false
        set end = len(stream)
      else
        set end = end + 1
  set end = delimiter
  let result = ""
  let index = start
  while index < end
    set result = result + chr(stream[index])
    set index = index + 1
  result

fn parse(stream: String) -> String
  let first = token_at(stream, 0)
  if len(first) > 0
    if first[0] == 77
      stream
    else
      ""
  else
    ""

